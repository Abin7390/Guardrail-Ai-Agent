# Google Gemini API credentials and settings - loaded by guard/llm.py (python-dotenv).
# Copy this file to .env and paste your real key; never commit the .env file.

GOOGLE_API_KEY=your-google-api-key-here

# Optional overrides (defaults shown):
# GUARD_LLM_API_KEY=your-google-api-key-here  (takes precedence over GOOGLE_API_KEY)
# GUARD_LLM_MODEL=gemini-3.8-flash
# GUARD_LLM_TIMEOUT=60
